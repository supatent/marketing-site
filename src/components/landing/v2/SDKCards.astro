---
// SDK Cards component - Get started in minutes
// Two-column layout: Websites/Apps and AI Agents
---

<section id="sdk" class="sdk-section">
  <div class="sdk-container">
    <div class="sdk-header">
      <h2 class="sdk-title">Get started in minutes</h2>
      <p class="sdk-subtitle">One SDK for websites, apps, and AI agents</p>
    </div>

    <div class="sdk-cards">
      <!-- For Websites & Apps -->
      <div class="sdk-card">
        <div class="sdk-card-header">
          <div class="sdk-icon websites">🌐</div>
          <h4>For Websites & Apps</h4>
        </div>
        <div class="sdk-card-body">
          <div class="code-block">
            <div class="code-header">
              <span>Terminal</span>
              <button class="copy-btn" data-copy="npm install @supatent/sdk">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                </svg>
                <span class="copy-text">Copy</span>
              </button>
            </div>
            <div class="code-content">
              <span class="comment">$</span> npm install @supatent/sdk
            </div>
          </div>

          <div class="code-block">
            <div class="code-header">
              <span>example.ts</span>
              <button class="copy-btn" data-copy="import { Supatent } from '@supatent/sdk';

const cms = new Supatent({
  apiKey: process.env.SUPATENT_KEY
});

const posts = await cms.collection('posts').all();">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                </svg>
                <span class="copy-text">Copy</span>
              </button>
            </div>
            <div class="code-content" set:html={`<span class="keyword">import</span> { <span class="function">Supatent</span> } <span class="keyword">from</span> <span class="string">'@supatent/sdk'</span>;

<span class="keyword">const</span> cms = <span class="keyword">new</span> <span class="function">Supatent</span>({
  apiKey: process.env.SUPATENT_KEY
});

<span class="keyword">const</span> posts = <span class="keyword">await</span> cms.<span class="function">collection</span>(<span class="string">'posts'</span>).<span class="function">all</span>();`} />
          </div>
        </div>
      </div>

      <!-- For AI Agents -->
      <div class="sdk-card">
        <div class="sdk-card-header">
          <div class="sdk-icon agents">🤖</div>
          <h4>For AI Agents</h4>
        </div>
        <div class="sdk-card-body">
          <div class="code-block">
            <div class="code-header">
              <span>Terminal</span>
              <button class="copy-btn" data-copy="npx @supatent/mcp">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                </svg>
                <span class="copy-text">Copy</span>
              </button>
            </div>
            <div class="code-content">
              <span class="comment">$</span> npx @supatent/mcp
            </div>
          </div>

          <div class="code-block">
            <div class="code-header">
              <span>mcp.json</span>
              <button class="copy-btn" data-copy='{"mcpServers":{"supatent":{"command":"npx","args":["@supatent/mcp"]}}}'>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                </svg>
                <span class="copy-text">Copy</span>
              </button>
            </div>
            <div class="code-content" set:html={`{
  <span class="string">"mcpServers"</span>: {
    <span class="string">"supatent"</span>: {
      <span class="string">"command"</span>: <span class="string">"npx"</span>,
      <span class="string">"args"</span>: [<span class="string">"@supatent/mcp"</span>]
    }
  }
}`} />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sdk-section {
    padding: 6rem 1.5rem;
    background: var(--bg-soft);
    transition: background 0.3s ease;
  }

  .sdk-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .sdk-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .sdk-title {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .sdk-subtitle {
    font-size: 1.0625rem;
    color: var(--text-secondary);
  }

  .sdk-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .sdk-card {
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 1rem;
    overflow: hidden;
    transition: background 0.3s ease;
  }

  .sdk-card-header {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border-light);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .sdk-icon {
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
  }

  .sdk-icon.websites {
    background: color-mix(in srgb, var(--accent-secondary, #8EEDC7) 20%, transparent);
  }

  .sdk-icon.agents {
    background: color-mix(in srgb, var(--accent-tertiary, #9B8DFF) 20%, transparent);
  }

  .sdk-card-header h4 {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .sdk-card-body {
    padding: 1.25rem;
  }

  .code-block {
    background: var(--bg-soft);
    border: 1px solid var(--border-light);
    border-radius: 0.625rem;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .code-block:last-child {
    margin-bottom: 0;
  }

  .code-header {
    padding: 0.625rem 1rem;
    background: var(--bg-muted, var(--bg-soft));
    border-bottom: 1px solid var(--border-light);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .code-header span {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: 'SF Mono', 'Fira Code', 'JetBrains Mono', monospace;
  }

  .copy-btn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 0.375rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s;
  }

  .copy-btn:hover {
    border-color: var(--accent-secondary, #8EEDC7);
    color: var(--accent-secondary, #8EEDC7);
  }

  .copy-btn.copied {
    border-color: var(--accent-secondary, #8EEDC7);
    color: var(--accent-secondary, #8EEDC7);
    background: color-mix(in srgb, var(--accent-secondary, #8EEDC7) 10%, transparent);
  }

  .code-content {
    padding: 1rem;
    font-family: 'SF Mono', 'Fira Code', 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--text-primary);
    overflow-x: auto;
    white-space: pre;
  }

  .code-content .comment { color: var(--text-muted); }
  .code-content .keyword { color: var(--accent-tertiary, #9B8DFF); }
  .code-content .string { color: var(--accent-secondary, #8EEDC7); }
  .code-content .function { color: var(--accent-primary); }

  @media (max-width: 768px) {
    .sdk-title {
      font-size: 1.5rem;
    }
  }
</style>

<script>
  // Copy to clipboard functionality
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy');
      if (text) {
        await navigator.clipboard.writeText(text);
        const copyText = btn.querySelector('.copy-text');
        if (copyText) {
          const original = copyText.textContent;
          copyText.textContent = 'Copied!';
          btn.classList.add('copied');
          setTimeout(() => {
            copyText.textContent = original;
            btn.classList.remove('copied');
          }, 2000);
        }
      }
    });
  });
</script>
