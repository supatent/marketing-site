---
// Community Gallery component - "Built with SUPATENT" showcase
// Shows real examples from the community to build trust
// Fetches projects from CMS with fallback to static data

import { cms, extractCollection, type CommunityProject } from '../../../lib/cms';

// Try to fetch community projects from CMS
let projects: CommunityProject[] = [];
try {
  projects = extractCollection<CommunityProject>(
    await cms.collection('community-projects').all()
  ).sort((a, b) => a.sort_order - b.sort_order);
} catch (error) {
  console.warn('Failed to fetch community projects from CMS, using fallback data');
}

// Fallback static data if CMS is empty or unavailable
if (projects.length === 0) {
  projects = [
    {
      title: "TechStartup Weekly",
      description: "AI-powered tech news in 6 languages",
      badge: "Blog",
      gradient: "gradient-1",
      stat_1_value: "142",
      stat_1_label: "articles",
      stat_2_value: "6",
      stat_2_label: "languages",
      sort_order: 1
    },
    {
      title: "DevToolKit Docs",
      description: "Always in sync, never outdated",
      badge: "Documentation",
      gradient: "gradient-2",
      stat_1_value: "89",
      stat_1_label: "pages",
      stat_2_value: "23",
      stat_2_label: "versions",
      sort_order: 2
    },
    {
      title: "GrowthLabs",
      description: "Landing pages that convert",
      badge: "Marketing",
      gradient: "gradient-3",
      stat_1_value: "12",
      stat_1_label: "campaigns",
      stat_2_value: "99.9%",
      stat_2_label: "uptime",
      sort_order: 3
    },
    {
      title: "Artisan Market",
      description: "Product stories that sell",
      badge: "E-commerce",
      gradient: "gradient-4",
      stat_1_value: "340",
      stat_1_label: "products",
      stat_2_value: "4",
      stat_2_label: "rollbacks",
      sort_order: 4
    },
    {
      title: "CodeSync API",
      description: "Versioned API documentation",
      badge: "Developer Tools",
      gradient: "gradient-5",
      stat_1_value: "56",
      stat_1_label: "endpoints",
      stat_2_value: "3",
      stat_2_label: "SDK langs",
      sort_order: 5
    },
    {
      title: "Makers Hub",
      description: "User-generated content, safely",
      badge: "Community",
      gradient: "gradient-6",
      stat_1_value: "2.4k",
      stat_1_label: "posts",
      stat_2_value: "100%",
      stat_2_label: "safe",
      sort_order: 6
    }
  ];
}
---

<section id="community" data-cms-collections="community-projects" class="community-section">
  <div class="community-container">
    <div class="community-header">
      <div class="header-content">
        <h2 class="community-title">From our Community</h2>
      </div>
      <a href="#" class="view-all-link">View all examples &rarr;</a>
    </div>

    <div class="community-grid">
      {projects.map((project) => (
        <div class="community-tile">
          <div class={`tile-preview ${project.gradient}`}>
            <span class="tile-badge">{project.badge}</span>
          </div>
          <div class="tile-content">
            <h4 class="tile-title">{project.title}</h4>
            <p class="tile-description">{project.description}</p>
            <div class="tile-stats">
              <span class="tile-stat">
                <strong>{project.stat_1_value}</strong> {project.stat_1_label}
              </span>
              <span class="tile-stat">
                <strong>{project.stat_2_value}</strong> {project.stat_2_label}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .community-section {
    padding: 5rem 0 6rem;
    background: var(--bg-base);
  }

  .community-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .community-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
  }

  .community-title {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .view-all-link {
    color: var(--accent-primary);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .view-all-link:hover {
    text-decoration: underline;
  }

  .community-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .community-tile {
    background: var(--bg-card);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--border-light);
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .community-tile:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-large), var(--shadow-glow);
    border-color: color-mix(in srgb, var(--accent-primary) 20%, transparent);
  }

  .tile-preview {
    aspect-ratio: 16/10;
    position: relative;
  }

  /* Gradient backgrounds for tiles */
  .tile-preview.gradient-1 { background: linear-gradient(135deg, #667eea, #764ba2); }
  .tile-preview.gradient-2 { background: linear-gradient(135deg, #f093fb, #f5576c); }
  .tile-preview.gradient-3 { background: linear-gradient(135deg, #4facfe, #00f2fe); }
  .tile-preview.gradient-4 { background: linear-gradient(135deg, #43e97b, #38f9d7); }
  .tile-preview.gradient-5 { background: linear-gradient(135deg, #fa709a, #fee140); }
  .tile-preview.gradient-6 { background: linear-gradient(135deg, #a8edea, #fed6e3); }

  .tile-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.3125rem 0.75rem;
    background: var(--tile-badge-bg, var(--bg-card));
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-primary);
    box-shadow: var(--shadow-soft);
  }

  .tile-content {
    padding: 1.25rem;
  }

  .tile-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .tile-description {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0.875rem;
  }

  .tile-stats {
    display: flex;
    gap: 1.25rem;
  }

  .tile-stat {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .tile-stat strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .community-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .community-title {
      font-size: 1.5rem;
    }
  }
</style>
