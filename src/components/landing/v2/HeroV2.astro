---
// Hero V2 component - Community-focused hero with rotating words
// "Content that just works for [blogs, docs, products, apps]"
---

<section class="hero-section">
  <div class="hero-bg"></div>
  <div class="hero-container">
    <div class="hero-content">
      <div class="hero-tagline">"You are on a mission to change the world"</div>
      <h1 class="hero-title">
        <span class="hero-line">Content that just works</span>
        <span class="hero-line">
          for <span class="hero-rotating-wrapper">
            <span class="word word-1">blogs</span>
            <span class="word word-2">docs</span>
            <span class="word word-3">products</span>
            <span class="word word-4">apps</span>
          </span>
        </span>
      </h1>
      <p class="hero-description">
        AI-powered content management with instant rollback, translations, and safety built in. Works with any stack.
      </p>
      <div class="hero-cta">
        <a href="#pricing" class="btn btn-primary">Start building &rarr;</a>
        <a href="#community" class="btn btn-secondary">See examples</a>
      </div>
      <div class="trust-badges">
        <div class="trust-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
          <span>10,000+ content items managed</span>
        </div>
        <div class="trust-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
          <span>99.9% uptime</span>
        </div>
        <div class="trust-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
          <span>50+ teams shipping</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 8.75rem 1.5rem 5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
    background: var(--bg-base);
    min-height: 90vh;
    display: flex;
    align-items: center;
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      radial-gradient(ellipse 60% 40% at 50% 0%, var(--hero-glow-1, color-mix(in srgb, var(--accent-primary) 10%, transparent)), transparent),
      radial-gradient(ellipse 40% 30% at 80% 20%, var(--hero-glow-2, color-mix(in srgb, var(--accent-secondary, #FFD93D) 8%, transparent)), transparent),
      radial-gradient(ellipse 40% 30% at 20% 30%, var(--hero-glow-3, color-mix(in srgb, var(--accent-tertiary, #9B8DFF) 8%, transparent)), transparent);
    pointer-events: none;
    transition: background 0.4s ease;
  }

  .hero-container {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .hero-content {
    position: relative;
  }

  .hero-tagline {
    display: inline-block;
    padding: 0.5rem 1.125rem;
    background: color-mix(in srgb, var(--accent-primary) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-primary) 30%, transparent);
    border-radius: 6.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent-primary);
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .hero-line {
    display: block;
  }

  .hero-rotating-wrapper {
    display: inline-block;
    position: relative;
    min-width: 180px;
    text-align: left;
  }

  .word {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    animation: rotateWord 12s infinite;
    white-space: nowrap;
  }

  .word:first-child {
    position: relative;
  }

  .word-1 { animation-delay: 0s; color: var(--accent-primary); }
  .word-2 { animation-delay: 3s; color: var(--accent-secondary, #8EEDC7); }
  .word-3 { animation-delay: 6s; color: var(--accent-tertiary, #9B8DFF); }
  .word-4 { animation-delay: 9s; color: var(--accent-quaternary, #4ECDC4); }

  @keyframes rotateWord {
    0%, 20% { opacity: 1; transform: translateY(0); }
    25%, 100% { opacity: 0; transform: translateY(-10px); }
  }

  .hero-description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: 34.375rem;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    border-radius: 0.625rem;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
    cursor: pointer;
    border: none;
  }

  .btn-primary {
    background: var(--accent-primary);
    color: var(--bg-base);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow, 0 0 60px color-mix(in srgb, var(--accent-primary) 20%, transparent));
  }

  .btn-secondary {
    background: var(--bg-card);
    color: var(--text-primary);
    border: 1px solid var(--border-light);
  }

  .btn-secondary:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }

  .trust-badges {
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .trust-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .trust-badge svg {
    width: 1rem;
    height: 1rem;
    color: var(--accent-secondary, #8EEDC7);
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 7rem 1rem 3rem;
      min-height: auto;
    }

    .hero-description {
      font-size: 1.125rem;
    }

    .trust-badges {
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    .hero-rotating-wrapper {
      min-width: 120px;
    }
  }
</style>
