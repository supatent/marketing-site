---
// CTA Section Component
import { cms, extractData, extractCollection, type LandingCTA, type Stat } from '../../lib/cms';

// Fetch CTA content and trust badge stats from CMS
const ctaData = extractData<LandingCTA>(await cms.collection('landing-cta').first());
const allStats = extractCollection<Stat>(await cms.collection('stats').all());
const trustBadges = allStats.filter(stat => stat.category === 'trust-badge').sort((a, b) => a.sort_order - b.sort_order);
---

<section id="cta" data-cms-collections="landing-cta,stats" class="cta-section">
  <div class="cta-container">
    <div class="cta-content">
      <h2 class="cta-title">
        {ctaData.title}
      </h2>
      <p class="cta-description">
        {ctaData.description}
      </p>

      <div class="cta-terminal">
        <div class="terminal-window">
          <div class="terminal-header">
            <div class="terminal-dots">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
          </div>
          <div class="terminal-body">
            <div class="terminal-line input">
              $ npm install @supatent/sdk
            </div>
            <div class="terminal-line output">
              ✓ Package installed successfully
            </div>
            <div class="terminal-line success">
              ✓ Ready to connect your AI agents
            </div>
          </div>
        </div>
      </div>

      <div class="cta-actions">
        <a href="#pricing" class="btn-electric">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
          </svg>
          {ctaData.primary_cta_text}
        </a>
        <a href="#features" class="btn-ghost">
          {ctaData.secondary_cta_text}
        </a>
      </div>

      <div class="trust-badges">
        {trustBadges.map((badge, index) => {
          // Define icons for badges
          const icons = [
            'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z',
            'M9 11l3 3L22 4M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11',
            'M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12 6.477 2 12 2zM12 6v6l4 2'
          ];
          const iconPath = icons[index % icons.length];

          return (
            <div class="badge">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d={iconPath} />
              </svg>
              <span>{badge.value} {badge.label}</span>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Background decoration -->
  <div class="cta-bg-decoration">
    <div class="glow-orb orb-1"></div>
    <div class="glow-orb orb-2"></div>
  </div>
</section>

<style>
  .cta-section {
    padding: 7.5rem 0;
    background: linear-gradient(180deg, var(--bg-base) 0%, var(--bg-soft) 50%, var(--bg-base) 100%);
    position: relative;
    overflow: hidden;
  }

  .cta-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 1;
  }

  .cta-content {
    text-align: center;
  }

  .cta-title {
    font-size: 3rem;
    font-weight: 900;
    margin-bottom: 1.5rem;
    background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent-primary) 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1.2;
  }

  @media (min-width: 768px) {
    .cta-title {
      font-size: 3.75rem;
    }
  }

  .cta-description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin-bottom: 3rem;
    line-height: 1.6;
  }

  /* Terminal */
  .cta-terminal {
    max-width: 500px;
    margin: 2rem auto;
  }

  .terminal-window {
    background: var(--bg-card);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border-light);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .terminal-header {
    padding: 0.75rem 1rem;
    background: var(--bg-soft);
    border-bottom: 1px solid var(--border-light);
  }

  .terminal-dots {
    display: flex;
    gap: 0.5rem;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot-red { background: #FF5F56; }
  .dot-yellow { background: #FFBD2E; }
  .dot-green { background: #27C93F; }

  .terminal-body {
    padding: 1.5rem;
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 0.95rem;
  }

  .terminal-line {
    margin: 0.5rem 0;
    line-height: 1.6;
  }

  .terminal-line.input {
    color: var(--text-primary);
  }

  .terminal-line.output,
  .terminal-line.success {
    color: #22C55E;
  }

  /* CTA Actions */
  .cta-actions {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin: 3rem 0;
  }

  .btn-electric,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.375rem;
    font-weight: 600;
    transition: all 0.2s ease;
    text-decoration: none;
    cursor: pointer;
    padding: 1.125rem 2.5rem;
    font-size: 1.125rem;
  }

  .btn-electric {
    background: var(--accent-primary);
    color: black;
    border: none;
  }

  .btn-electric:hover {
    filter: brightness(1.1);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--accent-primary) 30%, transparent);
  }

  .btn-electric svg {
    margin-right: 0.75rem;
  }

  .btn-ghost {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border-light);
  }

  .btn-ghost:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    transform: translateY(-2px);
  }

  /* Trust Badges */
  .trust-badges {
    display: flex;
    justify-content: center;
    gap: 3rem;
    margin-top: 4rem;
    flex-wrap: wrap;
  }

  .badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .badge svg {
    color: var(--accent-primary);
  }

  /* Background Decoration */
  .cta-bg-decoration {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.2;
  }

  .orb-1 {
    width: 600px;
    height: 600px;
    background: var(--accent-primary);
    top: -300px;
    left: -300px;
    animation: float 20s ease-in-out infinite;
  }

  .orb-2 {
    width: 400px;
    height: 400px;
    background: #22C55E;
    bottom: -200px;
    right: -200px;
    animation: float 15s ease-in-out infinite reverse;
  }

  @keyframes float {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(30px, -30px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
  }

  @media (max-width: 768px) {
    .cta-section {
      padding: 5rem 0;
    }

    .cta-title {
      font-size: 2rem;
    }

    .cta-description {
      font-size: 1.1rem;
    }

    .trust-badges {
      gap: 1.5rem;
    }

    .badge {
      font-size: 0.875rem;
    }

    .cta-actions {
      flex-direction: column;
      align-items: center;
    }

    .btn-electric,
    .btn-ghost {
      width: 100%;
      max-width: 300px;
    }
  }
</style>
