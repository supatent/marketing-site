---
// Pricing component for Vibe CMS marketing site
import { cms, extractCollection, type SectionHeading, type PricingPlan } from '../../lib/cms';

// Fetch section heading and pricing plans from CMS
const allHeadings = extractCollection<SectionHeading>(await cms.collection('section-headings').all());
const sectionHeading = allHeadings.find(h => h.slug === 'pricing');
const pricingPlans = extractCollection<PricingPlan>(await cms.collection('pricing-plans').all()).sort((a, b) => a.sort_order - b.sort_order);

// Helper to parse markdown list items
function parseFeaturesList(markdown: string | undefined): string[] {
  if (!markdown) {
    console.warn('Features markdown is undefined, returning empty array');
    return [];
  }
  return markdown
    .split('\n')
    .filter(line => line.trim().startsWith('-'))
    .map(line => line.trim().substring(1).trim());
}
---

<section id="pricing" data-cms-collections="section-headings,pricing-plans" class="bg-[#0A0A0B] text-white py-32 px-8">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-5xl md:text-6xl font-semibold mb-4 bg-gradient-to-br from-[#00D4FF] to-[#0080FF] bg-clip-text text-transparent">
        {sectionHeading?.title}
      </h2>
      <p class="text-xl text-gray-400 max-w-2xl mx-auto">
        {sectionHeading?.description}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      {pricingPlans.map(plan => {
        const features = parseFeaturesList(plan.features);
        const isFeatured = plan.slug === 'pro';

        return (
          <div class={`flex flex-col h-full ${isFeatured ? 'pricing-card-featured' : ''} bg-[#1A1A1C] border ${isFeatured ? 'border-[#00D4FF]' : 'border-gray-800'} rounded-2xl p-10 relative transition-all duration-300 hover:bg-[#1F1F21] ${isFeatured ? '' : 'hover:border-gray-700'} hover:-translate-y-1`}>
            {isFeatured && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[#00D4FF] text-black px-4 py-2 rounded-full text-sm font-medium z-10 shadow-[0_4px_12px_rgba(0,212,255,0.3)]">
                Most Popular
              </div>
            )}

            <div class="text-center mb-8 pb-8 border-b border-gray-800">
              <h3 class="text-2xl font-semibold mb-4 text-white">
                {plan.name}
              </h3>
              <div class="flex flex-col items-center gap-1">
                <span class="text-5xl font-bold text-white leading-none">{plan.price_amount}</span>
                <span class="text-base text-gray-400">{plan.price_period}</span>
              </div>
            </div>

            <div class="flex flex-col flex-1 gap-8">
              <ul class="features-list flex-1">
                {features.map(feature => (
                  <li>{feature}</li>
                ))}
              </ul>

              <a
                href="#"
                class={`mt-auto block w-full px-8 py-4 rounded-lg font-semibold text-base text-center no-underline transition-all duration-300 ${isFeatured ? 'bg-[#00D4FF] text-black hover:bg-[#00B8E6] shadow-[0_4px_12px_rgba(0,0,0,0.15)]' : 'bg-[#1A1A1C] text-white border border-gray-800 hover:bg-[#1F1F21] hover:border-[#00D4FF]'} hover:-translate-y-0.5`}
              >
                {plan.cta_text}
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <div class="text-center text-gray-400 text-base">
      <p>All plans include a 14-day free trial. No credit card required.</p>
    </div>
  </div>
</section>

<style>
/* Featured card gradient overlay - can't be done with Tailwind */
.pricing-card-featured::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 1rem;
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.08) 0%, rgba(0, 153, 204, 0.05) 100%);
  pointer-events: none;
}

/* Features list checkmarks - can't set ::before content with Tailwind */
.features-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.features-list li {
  color: #9CA3AF;
  padding-left: 1.5rem;
  position: relative;
  line-height: 1.5;
}

.features-list li::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: #00D4FF;
  font-weight: bold;
}
</style>
