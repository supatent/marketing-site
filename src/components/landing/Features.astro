---
// PowerGrid/Features section with tabbed interface
import { cms, extractCollection, type SectionHeading, type Feature } from '../../lib/cms';

// Fetch section heading and features from CMS
const allHeadings = extractCollection<SectionHeading>(await cms.collection('section-headings').all());
const sectionHeading = allHeadings.find(h => h.slug === 'features');
const features = extractCollection<Feature>(await cms.collection('features').all()).sort((a, b) => a.sort_order - b.sort_order);

// Helper to parse markdown list items into array of {title, description}
function parseMarkdownList(markdown: string | undefined): Array<{ title: string; description: string }> {
  if (!markdown) {
    console.warn('Markdown is undefined, returning empty array');
    return [];
  }
  return markdown
    .split('\n')
    .filter(line => line.trim().startsWith('-'))
    .map(line => {
      const content = line.trim().substring(1).trim();
      const parts = content.split(' - ');
      return {
        title: parts[0] || '',
        description: parts[1] || ''
      };
    });
}
---

<section id="features" data-cms-collections="section-headings,features" class="features-section">
  <div class="features-container">
    <div class="features-header">
      <h2 class="features-title">
        {sectionHeading?.title}
      </h2>
      <p class="features-subtitle">
        {sectionHeading?.description}
      </p>
    </div>

    <!-- Tabs -->
    <div class="features-tabs">
      {features.map((feature, index) => (
        <button class={`feature-tab ${index === 0 ? 'active' : ''}`} data-feature={feature.slug}>
          {feature.short_name}
        </button>
      ))}
    </div>

    <!-- Feature Content -->
    <div class="features-grid">
      <!-- Terminal Demo -->
      <div class="feature-demo" data-feature-content="safety">
        <div class="demo-card">
          <div class="demo-header">
            <div class="terminal-dots">
              <div class="dot dot-red"></div>
              <div class="dot dot-yellow"></div>
              <div class="dot dot-green"></div>
            </div>
            <span class="demo-title">AI Safety Check</span>
          </div>
          <div class="demo-body">
            <div class="terminal-line prompt">$ supatent check content --ai-detection</div>
            <div class="terminal-line">Analyzing content...</div>
            <div class="terminal-line success">
              <span>✓</span>
              <span>Brand guidelines: Pass</span>
            </div>
            <div class="terminal-line success">
              <span>✓</span>
              <span>Fact verification: Pass</span>
            </div>
            <div class="terminal-line success">
              <span>✓</span>
              <span>Compliance check: Pass</span>
            </div>
            <div class="terminal-line warning">
              <span>⚠</span>
              <span>Tone adjustment suggested</span>
            </div>
            <div class="terminal-result">
              Content approved for publication
            </div>
          </div>
        </div>
      </div>

      <div class="feature-demo hidden" data-feature-content="translation">
        <div class="demo-card">
          <div class="demo-header">
            <div class="terminal-dots">
              <div class="dot dot-red"></div>
              <div class="dot dot-yellow"></div>
              <div class="dot dot-green"></div>
            </div>
            <span class="demo-title">Translation Engine</span>
          </div>
          <div class="demo-body">
            <div class="terminal-line prompt">$ supatent translate --to es,fr,de</div>
            <div class="terminal-line">Translating 24 content items...</div>
            <div class="terminal-line success">
              <span>✓</span>
              <span>Spanish: 24/24 complete</span>
            </div>
            <div class="terminal-line success">
              <span>✓</span>
              <span>French: 24/24 complete</span>
            </div>
            <div class="terminal-line success">
              <span>✓</span>
              <span>German: 24/24 complete</span>
            </div>
            <div class="terminal-result">
              Translations published in 2.3 seconds
            </div>
          </div>
        </div>
      </div>

      <div class="feature-demo hidden" data-feature-content="seo">
        <div class="demo-card">
          <div class="demo-header">
            <div class="terminal-dots">
              <div class="dot dot-red"></div>
              <div class="dot dot-yellow"></div>
              <div class="dot dot-green"></div>
            </div>
            <span class="demo-title">SEO Optimizer</span>
          </div>
          <div class="demo-body">
            <div class="terminal-line prompt">$ supatent seo optimize --auto</div>
            <div class="terminal-line">Optimizing meta tags...</div>
            <div class="terminal-line success">
              <span>✓</span>
              <span>Title tags generated</span>
            </div>
            <div class="terminal-line success">
              <span>✓</span>
              <span>Meta descriptions created</span>
            </div>
            <div class="terminal-line success">
              <span>✓</span>
              <span>Open Graph tags added</span>
            </div>
            <div class="terminal-line success">
              <span>✓</span>
              <span>Schema markup injected</span>
            </div>
            <div class="terminal-result">
              SEO score: 98/100
            </div>
          </div>
        </div>
      </div>

      <div class="feature-demo hidden" data-feature-content="versioning">
        <div class="demo-card">
          <div class="demo-header">
            <div class="terminal-dots">
              <div class="dot dot-red"></div>
              <div class="dot dot-yellow"></div>
              <div class="dot dot-green"></div>
            </div>
            <span class="demo-title">Version Control</span>
          </div>
          <div class="demo-body">
            <div class="terminal-line prompt">$ supatent rollback --version 3</div>
            <div class="terminal-line">Rolling back content...</div>
            <div class="terminal-line info">
              <span>→</span>
              <span>Version 5 (current)</span>
            </div>
            <div class="terminal-line muted">
              <span>→</span>
              <span>Version 4</span>
            </div>
            <div class="terminal-line success">
              <span>✓</span>
              <span>Version 3 (restored)</span>
            </div>
            <div class="terminal-result">
              Rollback complete. Changes live instantly.
            </div>
          </div>
        </div>
      </div>

      <!-- Feature Description -->
      <div class="features-descriptions">
        {features.map((feature, index) => {
          const benefits = parseMarkdownList(feature.benefits);
          return (
            <div class={`feature-description ${index > 0 ? 'hidden' : ''}`} data-feature-desc={feature.slug}>
              <h3 class="feature-name">
                {feature.name}
              </h3>
              <p class="feature-desc-text">
                {feature.description}
              </p>
              <ul class="feature-benefits">
                {benefits.map(benefit => (
                  <li class="benefit-item">
                    <svg class="benefit-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <div>
                      <div class="benefit-title">{benefit.title}</div>
                      <div class="benefit-desc">{benefit.description}</div>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style>
  .features-section {
    padding: 5rem 0;
    background: var(--bg-soft);
  }

  .features-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  @media (min-width: 640px) {
    .features-container {
      padding: 0 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .features-container {
      padding: 0 2rem;
    }
  }

  .features-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .features-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  @media (min-width: 640px) {
    .features-title {
      font-size: 3rem;
    }
  }

  .features-subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: 48rem;
    margin: 0 auto;
  }

  /* Tabs */
  .features-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .feature-tab {
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 600;
    transition: all 0.2s;
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border-light);
    cursor: pointer;
  }

  .feature-tab:hover {
    border-color: var(--text-muted);
    color: var(--text-primary);
  }

  .feature-tab.active {
    background: var(--gradient-brand);
    color: white;
    border-color: var(--accent-primary);
  }

  /* Grid */
  .features-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .features-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Demo Cards */
  .demo-card {
    background: var(--bg-card);
    border-radius: 0.75rem;
    border: 1px solid var(--border-light);
    overflow: hidden;
    box-shadow: var(--shadow-large);
  }

  .demo-header {
    background: var(--bg-soft);
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-light);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .terminal-dots {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
  }

  .dot-red { background: #FF5F56; }
  .dot-yellow { background: #FFBD2E; }
  .dot-green { background: #27C93F; }

  .demo-title {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: monospace;
  }

  .demo-body {
    padding: 1.5rem;
    font-family: monospace;
    font-size: 0.875rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .terminal-line {
    color: var(--text-primary);
  }

  .terminal-line.prompt {
    color: var(--text-muted);
  }

  .terminal-line.success {
    color: #22C55E;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .terminal-line.warning {
    color: #FBBF24;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .terminal-line.info {
    color: #3B82F6;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .terminal-line.muted {
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .terminal-result {
    margin-top: 1rem;
    padding: 0.75rem;
    background: color-mix(in srgb, var(--accent-primary) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-primary) 30%, transparent);
    border-radius: 0.25rem;
    color: var(--accent-primary);
  }

  /* Feature Descriptions */
  .features-descriptions {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .feature-name {
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .feature-desc-text {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }

  .feature-benefits {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .benefit-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--accent-primary);
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .benefit-title {
    color: var(--text-primary);
    font-weight: 600;
  }

  .benefit-desc {
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .hidden {
    display: none;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.feature-tab');
    const demos = document.querySelectorAll('.feature-demo');
    const descriptions = document.querySelectorAll('.feature-description');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const feature = tab.getAttribute('data-feature');

        // Update tabs
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        // Update demos
        demos.forEach(demo => {
          if (demo.getAttribute('data-feature-content') === feature) {
            demo.classList.remove('hidden');
          } else {
            demo.classList.add('hidden');
          }
        });

        // Update descriptions
        descriptions.forEach(desc => {
          if (desc.getAttribute('data-feature-desc') === feature) {
            desc.classList.remove('hidden');
          } else {
            desc.classList.add('hidden');
          }
        });
      });
    });
  });
</script>
