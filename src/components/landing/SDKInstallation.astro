---
// SDK Installation section with code blocks
import { cms, extractCollection, type SectionHeading } from '../../lib/cms';

// Fetch section heading from CMS
const allHeadings = extractCollection<SectionHeading>(await cms.collection('section-headings').all());
const sectionHeading = allHeadings.find(h => h.slug === 'sdk-installation');
---

<section id="sdk-installation" data-cms-collections="section-headings" class="sdk-section">
  <div class="sdk-container">
    <div class="sdk-header">
      <h2 class="sdk-title">
        {sectionHeading?.title}
      </h2>
      <p class="sdk-description">
        {sectionHeading?.description}
      </p>
    </div>

    <div class="sdk-grid">
      <!-- For Websites & Apps -->
      <div class="sdk-column">
        <div class="column-header">
          <svg class="column-icon icon-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
          <h3 class="column-title">For Websites & Apps</h3>
        </div>

        <div class="code-block">
          <div class="code-header">
            <div class="terminal-dots">
              <div class="dot dot-red"></div>
              <div class="dot dot-yellow"></div>
              <div class="dot dot-green"></div>
            </div>
            <button class="copy-btn" data-copy="npm install @supatent/sdk">
              <svg class="copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              Copy
            </button>
          </div>
          <div class="code-body">
            <div class="code-prompt">$</div>
            <div class="code-command">npm install @supatent/sdk</div>
          </div>
        </div>

        <div class="code-block">
          <div class="code-header">
            <span class="code-filename">example.ts</span>
            <button class="copy-btn" data-copy="import { Supatent } from '@supatent/sdk';

const cms = new Supatent({
  apiKey: process.env.SUPATENT_API_KEY,
  projectId: 'your-project-id'
});

const posts = await cms.collection('posts').all();">
              <svg class="copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              Copy
            </button>
          </div>
          <div class="code-body code-body-large">
            <pre class="code-content"><span class="syntax-keyword">import</span> {'{'} <span class="syntax-class">Supatent</span> {'}'} <span class="syntax-keyword">from</span> <span class="syntax-string">'@supatent/sdk'</span>;<br/><br/><span class="syntax-keyword">const</span> cms = <span class="syntax-keyword">new</span> <span class="syntax-class">Supatent</span>({'{'}{'{'}<br/>  <span class="syntax-property">apiKey:</span> process.env.<span class="syntax-var">SUPATENT_API_KEY</span>,<br/>  <span class="syntax-property">projectId:</span> <span class="syntax-string">'your-project-id'</span><br/>{'}'}{'}'});<br/><br/><span class="syntax-keyword">const</span> posts = <span class="syntax-keyword">await</span> cms.<span class="syntax-method">collection</span>(<span class="syntax-string">'posts'</span>).<span class="syntax-method">all</span>();</pre>
          </div>
        </div>
      </div>

      <!-- For AI Agents -->
      <div class="sdk-column">
        <div class="column-header">
          <svg class="column-icon icon-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <h3 class="column-title">For AI Agents</h3>
        </div>

        <div class="code-block">
          <div class="code-header">
            <div class="terminal-dots">
              <div class="dot dot-red"></div>
              <div class="dot dot-yellow"></div>
              <div class="dot dot-green"></div>
            </div>
            <button class="copy-btn" data-copy="npx @supatent/mcp">
              <svg class="copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              Copy
            </button>
          </div>
          <div class="code-body">
            <div class="code-prompt">$</div>
            <div class="code-command">npx @supatent/mcp</div>
          </div>
        </div>

        <div class="code-block">
          <div class="code-header">
            <span class="code-filename">mcp.json</span>
            <button class="copy-btn" data-copy='{
  "mcpServers": {
    "supatent": {
      "command": "npx",
      "args": ["@supatent/mcp"],
      "env": {
        "SUPATENT_API_KEY": "your-api-key",
        "SUPATENT_PROJECT_ID": "your-project-id"
      }
    }
  }
}'>
              <svg class="copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              Copy
            </button>
          </div>
          <div class="code-body code-body-large">
            <pre class="code-content">{'{'}<br/>  <span class="syntax-class">"mcpServers"</span>: {'{'}<br/>    <span class="syntax-class">"supatent"</span>: {'{'}<br/>      <span class="syntax-class">"command"</span>: <span class="syntax-string">"npx"</span>,<br/>      <span class="syntax-class">"args"</span>: [<span class="syntax-string">"@supatent/mcp"</span>],<br/>      <span class="syntax-class">"env"</span>: {'{'}<br/>        <span class="syntax-class">"SUPATENT_API_KEY"</span>: <span class="syntax-string">"your-api-key"</span>,<br/>        <span class="syntax-class">"SUPATENT_PROJECT_ID"</span>: <span class="syntax-string">"your-project-id"</span><br/>      {'}'}<br/>    {'}'}<br/>  {'}'}<br/>{'}'}</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sdk-section {
    padding: 5rem 0;
    background: var(--bg-base);
  }

  .sdk-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  @media (min-width: 640px) {
    .sdk-container {
      padding: 0 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .sdk-container {
      padding: 0 2rem;
    }
  }

  .sdk-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .sdk-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  @media (min-width: 640px) {
    .sdk-title {
      font-size: 3rem;
    }
  }

  .sdk-description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: 42rem;
    margin: 0 auto;
  }

  .sdk-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .sdk-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .sdk-column {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .column-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .column-icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .icon-primary {
    color: var(--accent-primary);
  }

  .icon-secondary {
    color: #A78BFA;
  }

  .column-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .code-block {
    background: var(--bg-card);
    border-radius: 0.75rem;
    border: 1px solid var(--border-light);
    overflow: hidden;
  }

  .code-header {
    background: var(--bg-soft);
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-light);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .terminal-dots {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
  }

  .dot-red { background: #FF5F56; }
  .dot-yellow { background: #FFBD2E; }
  .dot-green { background: #27C93F; }

  .code-filename {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: monospace;
  }

  .copy-btn {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    background: none;
    border: none;
    cursor: pointer;
    transition: color 0.2s;
  }

  .copy-btn:hover {
    color: var(--text-primary);
  }

  .copy-icon {
    width: 1rem;
    height: 1rem;
  }

  .code-body {
    padding: 1.5rem;
    font-family: monospace;
    font-size: 0.875rem;
  }

  .code-body-large {
    overflow-x: auto;
  }

  .code-prompt {
    color: var(--text-muted);
  }

  .code-command {
    color: var(--text-primary);
    margin-top: 0.25rem;
  }

  .code-content {
    color: var(--text-primary);
    margin: 0;
    line-height: 1.6;
  }

  .syntax-keyword {
    color: #A78BFA;
  }

  .syntax-class {
    color: var(--accent-primary);
  }

  .syntax-string {
    color: #4ADE80;
  }

  .syntax-var {
    color: #FBBF24;
  }

  .syntax-property {
    color: var(--text-primary);
  }

  .syntax-method {
    color: var(--accent-primary);
  }
</style>

<script>
  // Copy to clipboard functionality
  document.addEventListener('DOMContentLoaded', () => {
    const copyButtons = document.querySelectorAll('.copy-btn');

    copyButtons.forEach(button => {
      button.addEventListener('click', async () => {
        const text = button.getAttribute('data-copy');
        if (text) {
          try {
            await navigator.clipboard.writeText(text);
            const originalText = button.innerHTML;
            button.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Copied!';
            button.classList.add('text-green-400');

            setTimeout(() => {
              button.innerHTML = originalText;
              button.classList.remove('text-green-400');
            }, 2000);
          } catch (err) {
            console.error('Failed to copy:', err);
          }
        }
      });
    });
  });
</script>
