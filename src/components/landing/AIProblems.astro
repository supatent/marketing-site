---
// AI Problems section with 4-card grid
import { cms, extractCollection, type SectionHeading, type Problem } from '../../lib/cms';

// Fetch section heading and problems from CMS
const allHeadings = extractCollection<SectionHeading>(await cms.collection('section-headings').all());
const sectionHeading = allHeadings.find(h => h.slug === 'ai-problems');
const problems = extractCollection<Problem>(await cms.collection('problems').all()).sort((a, b) => a.sort_order - b.sort_order);
---

<section id="ai-problems" data-cms-collections="section-headings,problems" class="py-20 bg-gradient-to-b from-[#0A0A0B] to-[#0F0F10]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl sm:text-5xl font-bold text-white mb-4">
        {sectionHeading?.title}
      </h2>
      <p class="text-xl text-gray-400 max-w-3xl mx-auto">
        {sectionHeading?.description}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      {problems.map((problem, index) => {
        // Define colors for each problem card
        const colors = [
          { border: 'red-500', bg: 'red-500', text: 'red-400' },
          { border: 'yellow-500', bg: 'yellow-500', text: 'yellow-400' },
          { border: 'orange-500', bg: 'orange-500', text: 'orange-400' },
          { border: 'purple-500', bg: 'purple-500', text: 'purple-400' }
        ];
        const color = colors[index % colors.length];

        // Define icons for each problem (you could also add icon type to CMS)
        const icons = [
          'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z',
          'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6',
          'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
          'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01'
        ];
        const iconPath = icons[index % icons.length];

        return (
          <div class={`bg-[#1A1A1C] rounded-xl border border-gray-800 p-6 hover:border-${color.border}/50 transition-colors group`}>
            <div class={`w-12 h-12 rounded-lg bg-${color.bg}/10 flex items-center justify-center mb-4 group-hover:bg-${color.bg}/20 transition-colors`}>
              <svg class={`w-6 h-6 text-${color.text}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPath} />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">{problem.title}</h3>
            <p class="text-gray-400 text-sm">
              {problem.description}
            </p>
          </div>
        );
      })}
    </div>

    <!-- Solution -->
    <div class="bg-gradient-to-br from-[#00D4FF]/10 to-purple-500/10 rounded-2xl border border-[#00D4FF]/30 p-8 md:p-12">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-[#00D4FF]/20 rounded-full text-[#00D4FF] text-sm font-semibold mb-6">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          The Solution
        </div>
        <h3 class="text-3xl font-bold text-white mb-4">
          Give your AI agents a single source of truth
        </h3>
        <p class="text-lg text-gray-300 mb-6">
          Vibe CMS acts as a content control layer between your AI agents and your users. Every piece of content is verified, version-controlled, and compliant before it reaches production.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <div class="flex items-center gap-2 text-gray-300">
            <svg class="w-5 h-5 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Human oversight</span>
          </div>
          <div class="flex items-center gap-2 text-gray-300">
            <svg class="w-5 h-5 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Instant rollback</span>
          </div>
          <div class="flex items-center gap-2 text-gray-300">
            <svg class="w-5 h-5 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Audit trail</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
