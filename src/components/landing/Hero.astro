---
// Hero section with rotating headline and chat interface
import { cms, parseRotatingWords, extractData, extractCollection, type LandingHero, type Stat } from '../../lib/cms';

// Fetch hero content from CMS
const heroResult = await cms.collection('landing-hero').first();
const heroData = extractData<LandingHero>(heroResult);
const allStatsRaw = await cms.collection('stats').all();
const allStats = extractCollection<Stat>(allStatsRaw);

// Filter stats by category
const heroStats = allStats.filter(stat => stat.category === 'hero').sort((a, b) => a.sort_order - b.sort_order);

// Parse rotating words from JSON string
const rotatingWords = parseRotatingWords(heroData.rotating_words);
const rotatingColors = ['#00D4FF', '#FF6B35', '#4ADE80', '#A78BFA', '#F59E0B'];
---

<section id="hero" data-cms-collections="landing-hero,stats" class="relative overflow-hidden bg-[#0A0A0B] pt-20 pb-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left: Headline and CTA -->
      <div class="space-y-8">
        <div class="space-y-4">
          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold leading-tight">
            <span class="text-white">{heroData.headline_prefix}</span>
            <br />
            <span id="rotating-text" class="typing-container inline-block min-h-[1.2em]">
              {rotatingWords.map((word, index) => (
                <span
                  class={`word word-${index + 1}`}
                  style={`--char-count: ${word.length}; --color: ${rotatingColors[index]}; --word-index: ${index};`}
                >
                  {word}
                </span>
              ))}
            </span>
          </h1>
          <p class="text-xl sm:text-2xl text-gray-400 max-w-xl">
            {heroData.description}
          </p>
        </div>

        <div class="flex flex-wrap gap-4">
          <a href="#pricing" class="inline-flex items-center px-8 py-4 bg-[#00D4FF] text-black font-semibold rounded-lg hover:bg-[#00B8E0] transition-colors">
            {heroData.primary_cta_text}
          </a>
          <a href="#features" class="inline-flex items-center px-8 py-4 border border-gray-700 text-white font-semibold rounded-lg hover:border-gray-600 transition-colors">
            {heroData.secondary_cta_text}
          </a>
        </div>

        <!-- Stats or trust indicators -->
        <div class="flex flex-wrap gap-8 pt-4">
          {heroStats.map(stat => (
            <div>
              <div class="text-3xl font-bold text-white">{stat.value}</div>
              <div class="text-sm text-gray-500">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Chat Interface Demo -->
      <div class="relative">
        <div class="bg-[#1A1A1C] rounded-2xl border border-gray-800 overflow-hidden shadow-2xl">
          <!-- Chat Header -->
          <div class="bg-[#0F0F10] px-6 py-4 border-b border-gray-800 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
            </div>
            <div class="text-sm text-gray-500 font-mono">AI Agent Console</div>
          </div>

          <!-- Chat Messages -->
          <div class="p-6 space-y-4 h-[400px] overflow-y-auto">
            <div class="space-y-2">
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-[#00D4FF] to-[#0080FF] flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </div>
                <div class="flex-1">
                  <div class="text-sm text-gray-400 mb-1">AI Agent</div>
                  <div class="bg-[#0F0F10] rounded-lg p-4 text-gray-300">
                    Fetching product descriptions from Vibe CMS...
                  </div>
                </div>
              </div>
            </div>

            <div class="space-y-2">
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div class="flex-1">
                  <div class="text-sm text-gray-400 mb-1">Vibe CMS</div>
                  <div class="bg-[#0F0F10] rounded-lg p-4 text-gray-300">
                    <div class="flex items-center gap-2 mb-2">
                      <span class="text-green-400">✓</span>
                      <span>Content verified</span>
                    </div>
                    <div class="flex items-center gap-2 mb-2">
                      <span class="text-green-400">✓</span>
                      <span>Brand guidelines applied</span>
                    </div>
                    <div class="flex items-center gap-2">
                      <span class="text-green-400">✓</span>
                      <span>GDPR compliant</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="space-y-2">
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-[#00D4FF] to-[#0080FF] flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </div>
                <div class="flex-1">
                  <div class="text-sm text-gray-400 mb-1">AI Agent</div>
                  <div class="bg-[#0F0F10] rounded-lg p-4 text-gray-300 border border-[#00D4FF]/30">
                    Generated 15 product descriptions with 100% accuracy. Ready to publish.
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Progress Indicator -->
          <div class="px-6 py-4 bg-[#0F0F10] border-t border-gray-800">
            <div class="flex items-center gap-2 mb-2">
              <div class="text-xs text-gray-500">Processing</div>
              <div class="flex-1 h-1 bg-gray-800 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-[#00D4FF] to-[#0080FF] scenario-progress"></div>
              </div>
            </div>
            <div class="flex items-center justify-between text-xs text-gray-500">
              <span>Scenario: Product Content Generation</span>
              <span id="scenario-counter">1/4</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Background gradient effects -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-[#00D4FF]/10 rounded-full blur-3xl -z-10"></div>
  <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl -z-10"></div>
</section>

<style>
  @keyframes progress {
    0% { width: 0%; }
    100% { width: 100%; }
  }

  .scenario-progress {
    animation: progress 3s ease-in-out infinite;
  }

  /* Terminal typing animation */
  .typing-container {
    position: relative;
    display: inline-block;
  }

  .typing-container .word {
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color);
    white-space: nowrap;
    overflow: hidden;
    border-right: 0.15em solid var(--color);
    opacity: 0;
    width: 0;
    animation:
      typing 17.5s steps(var(--char-count)) infinite,
      cursor-blink 0.75s step-end infinite;
  }

  /* Stagger each word's start time */
  .typing-container .word-1 {
    animation-delay: 0s, 0s;
  }

  .typing-container .word-2 {
    animation-delay: 3.5s, 3.5s;
  }

  .typing-container .word-3 {
    animation-delay: 7s, 7s;
  }

  .typing-container .word-4 {
    animation-delay: 10.5s, 10.5s;
  }

  .typing-container .word-5 {
    animation-delay: 14s, 14s;
  }

  /* Typing effect with hold and backspace */
  @keyframes typing {
    /* Type in: 0-1s (0-5.71%) */
    0% { opacity: 1; width: 0; }
    5.71% { opacity: 1; width: calc(var(--char-count) * 1ch); }

    /* Hold: 1-2.5s (5.71-14.29%) */
    14.29% { opacity: 1; width: calc(var(--char-count) * 1ch); }

    /* Backspace: 2.5-3.2s (14.29-18.29%) */
    18.29% { opacity: 1; width: 0; }

    /* Gap: 3.2-3.5s (18.29-20%) */
    20% { opacity: 0; width: 0; }

    /* Stay hidden until next cycle */
    100% { opacity: 0; width: 0; }
  }

  /* Cursor blink */
  @keyframes cursor-blink {
    0%, 50% { border-color: var(--color); }
    51%, 100% { border-color: transparent; }
  }
</style>

<script>
  // Scenario counter
  const scenarioCounter = document.getElementById('scenario-counter');
  if (scenarioCounter) {
    let count = 1;
    setInterval(() => {
      count = count >= 4 ? 1 : count + 1;
      scenarioCounter.textContent = `${count}/4`;
    }, 3000);
  }
</script>
