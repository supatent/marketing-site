---
// Integrations section with logos and scrolling tags
import { cms, extractCollection, type SectionHeading, type Integration, type UseCase } from '../../lib/cms';

// Fetch section headings
const allHeadings = extractCollection<SectionHeading>(await cms.collection('section-headings').all());
const integrationsHeading = allHeadings.find(h => h.slug === 'integrations');
const useCasesHeading = allHeadings.find(h => h.slug === 'use-cases');

// Fetch integrations and expand file references using SDK's asset_url
const rawIntegrations = extractCollection<Integration>(await cms.collection('integrations').all());
const integrations = rawIntegrations
  .map(integration => ({
    ...integration,
    logo: integration.logo && typeof integration.logo === 'string'
      ? {
          id: integration.logo,
          url: cms.asset_url(integration.logo),
          alt_text: integration.name
        }
      : integration.logo
  }))
  .sort((a, b) => a.sort_order - b.sort_order);

// Fetch use cases
const allUseCases = extractCollection<UseCase>(await cms.collection('use-cases').all());
const complianceUseCases = allUseCases.filter(uc => uc.category === 'compliance').sort((a, b) => a.sort_order - b.sort_order);
const contentTypeUseCases = allUseCases.filter(uc => uc.category === 'content-type').sort((a, b) => a.sort_order - b.sort_order);
---

<section id="integrations" data-cms-collections="section-headings,integrations,use-cases" class="integrations-section">
  <div class="integrations-container">
    <div class="integrations-header">
      <h2 class="integrations-title">
        {integrationsHeading?.title}
      </h2>
      <p class="integrations-subtitle">
        {integrationsHeading?.description}
      </p>
    </div>

    <!-- Platform Logos - Scrolling Tags Row 1 -->
    <div class="scroll-wrapper">
      <div class="scrolling-tags">
        {integrations.slice(0, Math.ceil(integrations.length / 2)).map(integration => (
          <span class="integration-tag">
            {integration.logo && (
              <img src={integration.logo.url} alt={integration.logo.alt_text || integration.name} class="integration-icon" />
            )}
            <span>{integration.name}</span>
          </span>
        ))}
        <!-- Duplicated for seamless loop -->
        {integrations.slice(0, Math.ceil(integrations.length / 2)).map(integration => (
          <span class="integration-tag">
            {integration.logo && (
              <img src={integration.logo.url} alt={integration.logo.alt_text || integration.name} class="integration-icon" />
            )}
            <span>{integration.name}</span>
          </span>
        ))}
      </div>
    </div>

    <!-- Platform Logos - Scrolling Tags Row 2 (reverse direction) -->
    <div class="scroll-wrapper">
      <div class="scrolling-tags-reverse">
        {integrations.slice(Math.ceil(integrations.length / 2)).map(integration => (
          <span class="integration-tag">
            {integration.logo && (
              <img src={integration.logo.url} alt={integration.logo.alt_text || integration.name} class="integration-icon" />
            )}
            <span>{integration.name}</span>
          </span>
        ))}
        <!-- Duplicated for seamless loop -->
        {integrations.slice(Math.ceil(integrations.length / 2)).map(integration => (
          <span class="integration-tag">
            {integration.logo && (
              <img src={integration.logo.url} alt={integration.logo.alt_text || integration.name} class="integration-icon" />
            )}
            <span>{integration.name}</span>
          </span>
        ))}
      </div>
    </div>

    <!-- What Could You Do Section -->
    <div class="usecases-header">
      <h3 class="usecases-title">
        {useCasesHeading?.title}
      </h3>
      <p class="usecases-subtitle">
        {useCasesHeading?.description}
      </p>
    </div>

    <!-- Scrolling Tags - Row 1 (Compliance) -->
    <div class="scroll-wrapper">
      <div class="scrolling-tags">
        {complianceUseCases.map(useCase => (
          <span class="usecase-tag">{useCase.name}</span>
        ))}
        <!-- Duplicated for seamless loop -->
        {complianceUseCases.map(useCase => (
          <span class="usecase-tag">{useCase.name}</span>
        ))}
      </div>
    </div>

    <!-- Scrolling Tags - Row 2 (Content Types - reverse direction) -->
    <div class="scroll-wrapper">
      <div class="scrolling-tags-reverse">
        {contentTypeUseCases.map(useCase => (
          <span class="usecase-tag">{useCase.name}</span>
        ))}
        <!-- Duplicated for seamless loop -->
        {contentTypeUseCases.map(useCase => (
          <span class="usecase-tag">{useCase.name}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .integrations-section {
    padding: 5rem 0;
    background: var(--bg-base);
  }

  .integrations-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  @media (min-width: 640px) {
    .integrations-container {
      padding: 0 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .integrations-container {
      padding: 0 2rem;
    }
  }

  .integrations-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .integrations-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  @media (min-width: 640px) {
    .integrations-title {
      font-size: 3rem;
    }
  }

  .integrations-subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: 48rem;
    margin: 0 auto;
  }

  /* Scroll Wrapper */
  .scroll-wrapper {
    position: relative;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  /* Gradient fade effect on edges */
  .scroll-wrapper::before,
  .scroll-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 120px;
    z-index: 10;
    pointer-events: none;
  }

  .scroll-wrapper::before {
    left: 0;
    background: linear-gradient(to right, var(--bg-base) 0%, transparent 100%);
  }

  .scroll-wrapper::after {
    right: 0;
    background: linear-gradient(to left, var(--bg-base) 0%, transparent 100%);
  }

  /* Scrolling Tags */
  .scrolling-tags,
  .scrolling-tags-reverse {
    display: flex;
    gap: 1rem;
    white-space: nowrap;
  }

  .scrolling-tags {
    animation: scroll-left 30s linear infinite;
  }

  .scrolling-tags-reverse {
    animation: scroll-right 30s linear infinite;
  }

  .scrolling-tags:hover,
  .scrolling-tags-reverse:hover {
    animation-play-state: paused;
  }

  @keyframes scroll-left {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @keyframes scroll-right {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  /* Integration Tags */
  .integration-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    color: var(--text-secondary);
  }

  .integration-icon {
    height: 1.5rem;
    width: auto;
    filter: grayscale(100%) brightness(0.8);
    opacity: 0.7;
  }

  [data-theme="light"] .integration-icon {
    filter: grayscale(100%) brightness(0.5);
  }

  /* Use Cases Header */
  .usecases-header {
    text-align: center;
    margin: 5rem 0 3rem;
  }

  .usecases-title {
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .usecases-subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
  }

  /* Use Case Tags */
  .usecase-tag {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 9999px;
    color: var(--text-secondary);
  }
</style>
