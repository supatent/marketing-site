---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { docsCms, extractCollection, type DocPage } from '../../lib/cms';

let docs: DocPage[] = [];

try {
  const result = await docsCms.collection('documentation-pages').all();
  docs = extractCollection<DocPage>(result);
  // Sort by sort_order if it exists
  if (docs.length > 0 && docs[0].sort_order !== undefined) {
    docs.sort((a, b) => (a.sort_order || 0) - (b.sort_order || 0));
  }
} catch (error) {
  console.error('Error fetching docs:', error);
}

// Group docs by category for the overview
const docsByCategory = docs.reduce((acc, doc) => {
  const category = doc.category || 'General';
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push(doc);
  return acc;
}, {} as Record<string, DocPage[]>);

const categories = Object.keys(docsByCategory);
---

<DocsLayout title="Documentation">
  <h1>Documentation</h1>
  <p class="intro">Welcome to the Vibe CMS documentation. Browse the topics below to get started.</p>

  {docs.length === 0 ? (
    <div class="empty-state">
      <p>No documentation pages found. Content is being loaded from Vibe CMS.</p>
      <p class="note">Make sure documentation items are published in the CMS.</p>
    </div>
  ) : (
    <div class="docs-overview">
      {categories.map(category => (
        <div class="category-section">
          <h2>{category}</h2>
          <div class="docs-grid">
            {docsByCategory[category].map(doc => (
              <a href={`/docs/${doc.slug}`} class="doc-card">
                <h3>{doc.title}</h3>
                {doc.description && <p>{doc.description}</p>}
                <span class="arrow">→</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  )}
</DocsLayout>

<style>
  .intro {
    font-size: 1.125rem;
    color: #a3a3a3;
    margin-bottom: 3rem;
  }

  .empty-state {
    padding: 3rem;
    background: #2a2a2a;
    border: 1px solid #333333;
    border-radius: 8px;
    text-align: center;
  }

  .empty-state p {
    color: #a3a3a3;
    margin-bottom: 0.5rem;
  }

  .empty-state .note {
    color: #737373;
    font-size: 0.875rem;
  }

  .docs-overview {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .category-section h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #e5e5e5;
    margin-bottom: 1.5rem;
  }

  .docs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }

  .doc-card {
    display: block;
    padding: 1.5rem;
    background: #2a2a2a;
    border: 1px solid #333333;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s;
    position: relative;
  }

  .doc-card:hover {
    border-color: #00D4FF;
    transform: translateY(-2px);
  }

  .doc-card h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: #e5e5e5;
    margin-top: 0;
  }

  .doc-card p {
    color: #737373;
    line-height: 1.6;
    font-size: 0.875rem;
    margin: 0;
  }

  .doc-card .arrow {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    color: #00D4FF;
    font-size: 1.25rem;
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.2s;
  }

  .doc-card:hover .arrow {
    opacity: 1;
    transform: translateX(0);
  }
</style>
