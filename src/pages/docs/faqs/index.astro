---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { docsCms, extractCollection, type DocPage } from '../../../lib/cms';

// Fetch FAQ/Troubleshooting docs (category: FAQ, Troubleshooting, or Support)
let faqDocs: DocPage[] = [];
try {
  const result = await docsCms.collection('documentation-pages').all();
  const allDocs = extractCollection<DocPage>(result);

  // Filter for FAQ/Troubleshooting/Support category
  faqDocs = allDocs
    .filter(doc =>
      doc.category === 'FAQ' ||
      doc.category === 'Troubleshooting' ||
      doc.category === 'Support' ||
      doc.category === 'Guide' // Include guides that are FAQ-like
    )
    .filter(doc =>
      doc.title.toLowerCase().includes('faq') ||
      doc.title.toLowerCase().includes('troubleshoot') ||
      doc.title.toLowerCase().includes('support') ||
      doc.title.toLowerCase().includes('question')
    )
    .sort((a, b) => {
      const orderA = (a as any).order || a.sort_order || 0;
      const orderB = (b as any).order || b.sort_order || 0;
      return orderA - orderB;
    });
} catch (error) {
  console.error('Error fetching FAQ docs:', error);
}
---

<DocsLayout title="FAQs & Support" activeTab="faqs">
  <h1>Frequently Asked Questions</h1>
  <p class="intro">Common questions, troubleshooting guides, and support resources.</p>

  {faqDocs.length === 0 ? (
    <div class="empty-state">
      <h2>Help & Support</h2>
      <p>FAQ and troubleshooting documentation is currently being organized.</p>
      <p class="note">For immediate help, check the <a href="/docs">tutorial documentation</a> or reach out to support.</p>
    </div>
  ) : (
    <div class="docs-overview">
      <div class="category-section">
        <h2>Help Resources</h2>
        <div class="docs-grid">
          {faqDocs.map(doc => (
            <a href={`/docs/${doc.slug}`} class="doc-card">
              <h3>{doc.title}</h3>
              {doc.description && <p>{doc.description}</p>}
              <span class="arrow">→</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  <div class="support-section">
    <h2>Need More Help?</h2>
    <div class="support-grid">
      <div class="support-card">
        <h3>📚 Documentation</h3>
        <p>Comprehensive tutorials and guides</p>
        <a href="/docs" class="support-link">Browse Docs →</a>
      </div>
      <div class="support-card">
        <h3>💬 Community</h3>
        <p>Connect with other Vibe CMS users</p>
        <a href="https://github.com/dufourpascal/vibe_cms/discussions" class="support-link" target="_blank">Join Discussion →</a>
      </div>
      <div class="support-card">
        <h3>🐛 Report Issue</h3>
        <p>Found a bug or have a feature request?</p>
        <a href="https://github.com/dufourpascal/vibe_cms/issues" class="support-link" target="_blank">Create Issue →</a>
      </div>
    </div>
  </div>
</DocsLayout>

<style>
  .intro {
    font-size: 1.125rem;
    color: #a3a3a3;
    margin-bottom: 3rem;
  }

  .empty-state {
    padding: 3rem;
    background: #2a2a2a;
    border: 1px solid #333333;
    border-radius: 8px;
    text-align: center;
    margin-bottom: 3rem;
  }

  .empty-state h2 {
    color: #e5e5e5;
    margin-bottom: 1rem;
  }

  .empty-state p {
    color: #a3a3a3;
    margin-bottom: 0.5rem;
  }

  .empty-state .note {
    color: #737373;
    font-size: 0.875rem;
  }

  .empty-state a {
    color: #00D4FF;
    text-decoration: none;
  }

  .empty-state a:hover {
    text-decoration: underline;
  }

  .docs-overview {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .category-section h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #e5e5e5;
    margin-bottom: 1.5rem;
  }

  .docs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }

  .doc-card {
    display: block;
    padding: 1.5rem;
    background: #2a2a2a;
    border: 1px solid #333333;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s;
    position: relative;
  }

  .doc-card:hover {
    border-color: #00D4FF;
    transform: translateY(-2px);
  }

  .doc-card h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: #e5e5e5;
    margin-top: 0;
  }

  .doc-card p {
    color: #737373;
    line-height: 1.6;
    font-size: 0.875rem;
    margin: 0;
  }

  .doc-card .arrow {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    color: #00D4FF;
    font-size: 1.25rem;
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.2s;
  }

  .doc-card:hover .arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .support-section {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid #333333;
  }

  .support-section h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #e5e5e5;
    margin-bottom: 1.5rem;
  }

  .support-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .support-card {
    padding: 1.5rem;
    background: #2a2a2a;
    border: 1px solid #333333;
    border-radius: 8px;
    transition: all 0.2s;
  }

  .support-card:hover {
    border-color: #00D4FF;
  }

  .support-card h3 {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
    color: #e5e5e5;
  }

  .support-card p {
    color: #a3a3a3;
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }

  .support-link {
    display: inline-block;
    color: #00D4FF;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: transform 0.2s;
  }

  .support-link:hover {
    transform: translateX(4px);
  }
</style>
