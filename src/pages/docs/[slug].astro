---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { docsCms, extractCollection, type DocPage } from '../../lib/cms';
import { marked } from 'marked';

// Get all doc pages to generate static paths
export async function getStaticPaths() {
  try {
    const result = await docsCms.collection('documentation-pages').all();
    const docs = extractCollection<DocPage>(result);

    return docs.map(doc => ({
      params: { slug: doc.slug },
      props: { doc }
    }));
  } catch (error) {
    console.error('Error fetching docs:', error);
    return [];
  }
}

const { doc } = Astro.props;

// Use marked library for proper markdown parsing
const htmlContent = marked.parse(doc.content || '');
---

<DocsLayout title={doc.title} currentSlug={doc.slug}>
  <!-- Toast Notification -->
  <div id="toast-notification" class="toast-notification">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
    <span id="toast-message">Copied to clipboard!</span>
  </div>

  <div class="page-header">
    <h1>{doc.title}</h1>
    <button id="copy-page-btn" class="copy-page-button" title="Copy page as markdown">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <span>Copy Page</span>
    </button>
  </div>
  {doc.description && <p class="description">{doc.description}</p>}
  <div class="content" set:html={htmlContent} />
</DocsLayout>

<script define:vars={{ markdownContent: doc.content, pageTitle: doc.title }}>
  document.addEventListener('DOMContentLoaded', () => {
    // Toast notification function
    function showToast(message = 'Copied to clipboard!') {
      const toast = document.getElementById('toast-notification');
      const toastMessage = document.getElementById('toast-message');
      if (!toast || !toastMessage) return;

      toastMessage.textContent = message;
      toast.classList.add('show');

      setTimeout(() => {
        toast.classList.remove('show');
      }, 3000);
    }

    // Copy page button
    const copyBtn = document.getElementById('copy-page-btn');
    copyBtn?.addEventListener('click', async () => {
      try {
        const fullMarkdown = `# ${pageTitle}\n\n${markdownContent}`;
        await navigator.clipboard.writeText(fullMarkdown);
        showToast('Page copied to clipboard!');
      } catch (err) {
        console.error('Failed to copy:', err);
        showToast('Failed to copy');
      }
    });

    // Add copy buttons to all code blocks
    const codeBlocks = document.querySelectorAll('.content pre');

    codeBlocks.forEach((pre) => {
      // Create wrapper for positioning
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrapper';

      // Wrap the pre element
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      // Create copy button
      const copyCodeBtn = document.createElement('button');
      copyCodeBtn.className = 'copy-code-button';
      copyCodeBtn.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
      `;
      copyCodeBtn.title = 'Copy code';

      // Add click handler
      copyCodeBtn.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.textContent || pre.textContent || '';

        try {
          await navigator.clipboard.writeText(code);
          showToast('Code copied to clipboard!');

          // Brief visual feedback on button
          copyCodeBtn.classList.add('copied');
          setTimeout(() => {
            copyCodeBtn.classList.remove('copied');
          }, 1000);
        } catch (err) {
          console.error('Failed to copy code:', err);
          showToast('Failed to copy code');
        }
      });

      wrapper.appendChild(copyCodeBtn);
    });
  });
</script>

<style>
  /* Toast Notification */
  .toast-notification {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.5rem;
    background: #166534;
    color: #fff;
    border-radius: 8px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    font-size: 0.875rem;
    font-weight: 500;
    opacity: 0;
    transform: translateY(1rem);
    transition: all 0.3s ease;
    pointer-events: none;
    z-index: 1000;
  }

  .toast-notification.show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .toast-notification svg {
    flex-shrink: 0;
  }

  /* Page Header */
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    gap: 1rem;
  }

  .page-header h1 {
    margin: 0;
  }

  .copy-page-button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: #2a2a2a;
    color: #e5e5e5;
    border: 1px solid #333333;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .copy-page-button:hover {
    background: #333333;
    border-color: #4a4a4a;
    transform: translateY(-1px);
  }

  .copy-page-button:active {
    transform: translateY(0);
  }

  .copy-page-button svg {
    flex-shrink: 0;
  }

  .description {
    font-size: 1.125rem;
    color: #737373;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #333333;
  }

  .content {
    line-height: 1.8;
  }

  /* Code Block Wrapper */
  :global(.code-block-wrapper) {
    position: relative;
    margin-bottom: 1.25rem;
  }

  :global(.code-block-wrapper pre) {
    margin: 0;
  }

  /* Copy Code Button */
  :global(.copy-code-button) {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background: #333333;
    color: #a3a3a3;
    border: 1px solid #4a4a4a;
    border-radius: 6px;
    cursor: pointer;
    opacity: 0;
    transition: all 0.2s ease;
    padding: 0;
  }

  :global(.code-block-wrapper:hover .copy-code-button) {
    opacity: 1;
  }

  :global(.copy-code-button:hover) {
    background: #4a4a4a;
    color: #e5e5e5;
    border-color: #5a5a5a;
  }

  :global(.copy-code-button.copied) {
    background: #166534;
    border-color: #22c55e;
    color: #fff;
  }

  :global(.copy-code-button svg) {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 640px) {
    .page-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .copy-page-button {
      width: 100%;
      justify-content: center;
    }

    .toast-notification {
      bottom: 1rem;
      right: 1rem;
      left: 1rem;
    }

    :global(.copy-code-button) {
      opacity: 1;
    }
  }
</style>
