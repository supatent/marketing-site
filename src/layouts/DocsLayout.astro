---
import BaseLayout from './BaseLayout.astro';
import { docsCms, extractCollection, type DocPage } from '../lib/cms';

interface Props {
  title: string;
  currentSlug?: string;
}

const { title, currentSlug } = Astro.props;

// Fetch all docs for sidebar navigation
let allDocs: DocPage[] = [];
try {
  const result = await docsCms.collection('documentation-pages').all();
  allDocs = extractCollection<DocPage>(result);
  // Sort by order field (note: field is called 'order' in CMS, not 'sort_order')
  if (allDocs.length > 0) {
    allDocs.sort((a, b) => {
      const orderA = (a as any).order || a.sort_order || 0;
      const orderB = (b as any).order || b.sort_order || 0;
      return orderA - orderB;
    });
  }
} catch (error) {
  console.error('Error fetching docs for sidebar:', error);
}

// Group docs by category
const docsByCategory = allDocs.reduce((acc, doc) => {
  const category = doc.category || 'General';
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push(doc);
  return acc;
}, {} as Record<string, DocPage[]>);

const categories = Object.keys(docsByCategory);

// Top-level tabs (can be customized based on your needs)
const tabs = [
  { name: 'Documentation', slug: 'documentation', active: true },
  { name: 'API Reference', slug: 'api-reference', active: false },
  { name: 'Examples', slug: 'examples', active: false },
  { name: 'FAQs', slug: 'faqs', active: false },
];
---

<BaseLayout title={`${title} - Vibe CMS Docs`}>
  <div class="docs-wrapper">
    <!-- Header with tabs -->
    <header class="docs-header">
      <div class="docs-header-content">
        <div class="logo">
          <a href="/">
            <span class="logo-text">Vibe CMS Docs</span>
          </a>
        </div>
        <nav class="tabs">
          {tabs.map(tab => (
            <a
              href={tab.slug === 'documentation' ? '/docs' : `/${tab.slug}`}
              class={`tab ${tab.active ? 'active' : ''}`}
            >
              {tab.name}
            </a>
          ))}
        </nav>
        <div class="header-actions">
          <a href="https://github.com/dufourpascal/vibe_cms" target="_blank" class="btn-github">
            GitHub
          </a>
        </div>
      </div>
    </header>

    <div class="docs-container">
      <!-- Sidebar navigation -->
      <aside class="docs-sidebar">
        <div class="sidebar-content">
          {categories.map(category => (
            <div class="sidebar-section">
              <h3 class="sidebar-category">{category}</h3>
              <ul class="sidebar-links">
                {docsByCategory[category].map(doc => (
                  <li>
                    <a
                      href={`/docs/${doc.slug}`}
                      class={`sidebar-link ${currentSlug === doc.slug ? 'active' : ''}`}
                    >
                      {doc.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </aside>

      <!-- Main content area -->
      <main class="docs-content">
        <article class="prose">
          <slot />
        </article>
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  .docs-wrapper {
    min-height: 100vh;
    background: #1a1a1a;
    color: #e5e5e5;
  }

  /* Header */
  .docs-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(26, 26, 26, 0.8);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid #333333;
  }

  .docs-header-content {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    gap: 3rem;
    height: 64px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: #e5e5e5;
    font-weight: 600;
    font-size: 1.125rem;
  }

  .logo-icon {
    font-size: 1.5rem;
  }

  .tabs {
    display: flex;
    gap: 0.5rem;
    flex: 1;
  }

  .tab {
    padding: 0.5rem 1rem;
    text-decoration: none;
    color: #a3a3a3;
    border-radius: 6px;
    transition: all 0.2s;
    font-size: 0.875rem;
  }

  .tab:hover {
    color: #e5e5e5;
    background: #2a2a2a;
  }

  .tab.active {
    color: #e5e5e5;
    background: #2a2a2a;
  }

  .header-actions {
    display: flex;
    gap: 1rem;
  }

  .btn-github {
    padding: 0.5rem 1rem;
    background: #333333;
    color: #e5e5e5;
    text-decoration: none;
    border-radius: 6px;
    font-size: 0.875rem;
    transition: background 0.2s;
  }

  .btn-github:hover {
    background: #4a4a4a;
  }

  /* Container */
  .docs-container {
    max-width: 1600px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 2rem;
  }

  /* Sidebar */
  .docs-sidebar {
    position: sticky;
    top: 80px;
    height: calc(100vh - 80px);
    overflow-y: auto;
    padding: 2rem 0 2rem 2rem;
    border-right: 1px solid #333333;
  }

  .sidebar-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sidebar-category {
    font-size: 0.875rem;
    font-weight: 600;
    color: #e5e5e5;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .sidebar-link {
    display: block;
    padding: 0.5rem 0.75rem;
    color: #a3a3a3;
    text-decoration: none;
    border-radius: 6px;
    font-size: 0.875rem;
    transition: all 0.2s;
  }

  .sidebar-link:hover {
    color: #e5e5e5;
    background: #2a2a2a;
  }

  .sidebar-link.active {
    color: #00D4FF;
    background: rgba(0, 212, 255, 0.1);
    font-weight: 500;
  }

  /* Main content */
  .docs-content {
    padding: 2rem 2rem 4rem 0;
    max-width: 900px;
  }

  .prose {
    line-height: 1.8;
  }

  .prose :global(h1) {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: #e5e5e5;
    margin-top: 0;
  }

  .prose :global(h2) {
    font-size: 1.875rem;
    font-weight: 600;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: #e5e5e5;
  }

  .prose :global(h3) {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: #e5e5e5;
  }

  .prose :global(p) {
    margin-bottom: 1.25rem;
    color: #a3a3a3;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-left: 1.5rem;
    margin-bottom: 1.25rem;
    color: #a3a3a3;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(pre) {
    background: #2a2a2a;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1.25rem;
  }

  .prose :global(code) {
    font-family: 'Courier New', monospace;
    font-size: 0.875rem;
    color: #00D4FF;
  }

  .prose :global(pre code) {
    color: #e5e5e5;
  }

  .prose :global(a) {
    color: #00D4FF;
    text-decoration: none;
  }

  .prose :global(a:hover) {
    text-decoration: underline;
  }

  /* Scrollbar styling */
  .docs-sidebar::-webkit-scrollbar {
    width: 6px;
  }

  .docs-sidebar::-webkit-scrollbar-track {
    background: transparent;
  }

  .docs-sidebar::-webkit-scrollbar-thumb {
    background: #333333;
    border-radius: 3px;
  }

  .docs-sidebar::-webkit-scrollbar-thumb:hover {
    background: #4a4a4a;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .docs-container {
      grid-template-columns: 240px 1fr;
    }
  }

  @media (max-width: 768px) {
    .docs-container {
      grid-template-columns: 1fr;
    }

    .docs-sidebar {
      display: none;
    }

    .docs-header-content {
      padding: 0 1rem;
    }

    .tabs {
      display: none;
    }

    .docs-content {
      padding: 2rem 1rem;
    }
  }
</style>
