---
import '../styles/global.css';
import '../styles/themes.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
	title?: string;
	description?: string;
	showThemeToggle?: boolean;
}

const {
	title = 'Vibe CMS - AI-Powered Content Management',
	description = 'Built for AI agents. Keep your content consistent, compliant, and accurate. Connect Claude, ChatGPT, Gemini, and more to your CMS.',
	showThemeToggle = true
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			// Prevent flash of wrong theme on page load
			(function() {
				const savedTheme = localStorage.getItem('supatent-theme') || 'light';
				document.documentElement.setAttribute('data-theme', savedTheme);
			})();
		</script>
	</head>
	<body>
		<slot />
		{showThemeToggle && <ThemeToggle />}
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
